# HASHCODE REBOOT — exemple de variables d'environnement.
# Copier vers `.env` pour le dev local. Ne jamais commiter de vrais secrets.

# --- Admin (requis pour /admin, /api/members/[id]/invite) ---
# L'accès admin est piloté par la colonne `Member.adminRole` en base :
# "operator" (accès complet) | "viewer" (lecture seule) | null (ordinaire).
# Fail-closed : null = pas admin. Poser le rôle via :
#   node --env-file=.env --import tsx scripts/seed-admin-role.ts

# --- Cron (requis pour /api/cron/* — header "Authorization: Bearer $CRON_SECRET") ---
# Sur VPS, ce secret est consommé par le SERVICE `cron` interne (compose.yml),
# qui appelle http://web:3000/api/cron/* depuis le réseau backend — plus par
# cron-job.org. Une fois le service `cron` actif, DÉSACTIVER les 5 jobs
# cron-job.org (voir docs/deploiement-docker.md, section « Crons »), sinon
# chaque tâche tournerait en double.
# Générer avec : openssl rand -base64 32. Ne jamais commiter de valeur réelle.
CRON_SECRET=

# --- WhatsApp community ---
# Client (inliné dans le bundle navigateur, utilisé par welcome.tsx) :
NEXT_PUBLIC_WHATSAPP_URL=
# Server (prioritaire côté server : invite route + auto-controls) :
WHATSAPP_URL=

# --- Salles d'ateliers (Google Meet) ---
# Salle utilisée pour les ateliers / séances en ligne. Elle est publique par
# conception : elle alimente le champ `url` des événements, affiché sur la page
# publique /evenements et dans l'agenda des membres.
# Sert aussi de valeur par défaut au script scripts/seed-github-program.ts.
NEXT_PUBLIC_MEET_URL=

# --- URLs publiques ---
# URL absolue du site (utilisée dans les emails, OG tags, sitemap) :
NEXT_PUBLIC_SITE_URL=https://reboot.joinhashcode.com
# URL alternative utilisée par les pages profil (fallback localhost:3000) :
NEXT_PUBLIC_URL=https://reboot.joinhashcode.com

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://reboot.joinhashcode.com

# --- Resend (emails transactionnels) ---
RESEND_API_KEY=
# Format : "Nom affiché <adresse@domaine-vérifié>"
EMAIL_FROM="HASHCODE REBOOT <reboot@reboot.joinhashcode.com>"
# Secret webhook pour vérifier la signature Svix (https://docs.resend.com/webhooks)
RESEND_WEBHOOK_SECRET=

# --- Brevo (emails de masse / marketing — voir https://developers.brevo.com/) ---
# Répartition des providers (voir src/lib/email/transport.ts) :
#   Resend  = OTP, codes, transactionnel et notifications (tout le technique)
#   Brevo   = emails de masse et marketing (welcome, invitation, relance…)
# Ce routage par catégorie n'est respecté QUE si EMAIL_PROVIDER vaut resend
# (ou est absent). Le mettre à "brevo" force Brevo en prioritaire POUR TOUT,
# y compris les codes de connexion — ce qui a déjà cassé les envois en prod
# (Brevo accepte en 201 mais ne livre pas quand la plateforme transactionnelle
# est désactivée). Ne le passer à brevo que volontairement et temporairement.
EMAIL_PROVIDER=resend
# Plan gratuit : 300 emails/jour. Envoi : POST /v3/smtp/email (doc : /docs/send-a-transactional-email).
# Sécurité IP : app.brevo.com → nom (haut-droite) → Security → Authorized IPs.
# Serveur auto-hébergé (IP fixe) : autoriser l'IP publique du VPS uniquement.
BREVO_API_KEY=
BREVO_EMAIL_FROM=
# Secret du webhook Brevo : configurer dans Brevo → Transactional → Webhooks
# → URL https://reboot.joinhashcode.com/api/webhooks/brevo?secret=<valeur>.
# Fallback CRON_SECRET si absent. Fail-closed en production.
BREVO_WEBHOOK_SECRET=
# Fallback Resend → Brevo automatique quand Resend renvoie 429 (quota) :
BREVO_FALLBACK_ON_429=true

# --- Garde-fou de quota d'envoi (src/lib/email-budget.ts) ---
# Quotas journaliers réels de chaque provider. Le code compte les envois
# réellement acceptés depuis 00:00 UTC et réduit automatiquement la taille des
# lots (puis suspend les envois) à l'approche de la limite. Sans ces valeurs,
# les défauts sont utilisés : 300 (Brevo) et 100 (Resend).
# À ajuster si le plan change — sinon le garde-fou protège une limite périmée.
BREVO_DAILY_CAP=300
RESEND_DAILY_CAP=100

# --- Upstash Redis (rate limiting distribué) ---

# --- Database (PostgreSQL via Prisma) ---
# Nom unique, utilisé par le runtime ET par les migrations : il n'y a pas de
# pooler devant le Postgres de la stack, donc rien à distinguer.
# En local, ce n'est pas vous qui la fournissez : compose.yml la construit à
# partir de POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB (plus bas).
DATABASE_URL=

# --- SMTP Local (fallback ultime — DÉSACTIVÉ sur Vercel) ---
# ⚠️ Sur Vercel, pas de Docker/local SMTP possible.
# Pour activer plus tard : utiliser un relay externe (Mailgun, Postmark, etc.)
# ou un VPS avec Postfix/SMTP.
# SMTP_HOST=relay.externe.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_TIMEOUT_MS=10000

# --- Cloudflare Turnstile (captcha admin) ---
# Obtenir une clé sur https://dash.cloudflare.com/?to=/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sentry (monitoring erreurs, optionnel mais recommandé en prod) ---
# Créer un projet sur sentry.io, puis copier la DSN ici.

# --- Ticket de remplissage WhatsApp (optionnel) ---
# Clé HMAC du ticket posé à l'inscription pour autoriser POST /api/account/phone
# sans session (voir src/lib/phone-fill-ticket.ts). Si absent, DATABASE_URL
# sert de clé (séparation de domaine "phone-fill-v1:"). Sans les deux, aucun
# ticket n'est émis et la route refuse toute écriture (fail-closed).
# PHONE_FILL_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
# DOCKER / SELF-HOSTED
# ═══════════════════════════════════════════════════════════════════════════
# docker-compose.yml lit TOUT depuis ce fichier (env_file). Aucune variable
# applicative n'est déclarée dans le compose : en ajouter une ici suffit,
# elle est disponible dans le conteneur sans modifier la config Docker.
#
# Seul le bloc ci-dessous est propre au self-hosted — les variables déjà
# définies plus haut (DATABASE_URL, BETTER_AUTH_SECRET, ADMIN_OPERATORS,
# BREVO_API_KEY, RESEND_API_KEY, EMAIL_FROM…) sont réutilisées telles quelles.
#
# Générer les secrets :
#   openssl rand -base64 24   → POSTGRES_PASSWORD
#   openssl rand -base64 32   → BETTER_AUTH_SECRET

# --- Routage Traefik ---
# Domaine public, SANS https:// : c'est la règle de routage Host(`...`).
PUBLIC_HOST=reboot.joinhashcode.com

# URL complète, AVEC https:// : utilisée par Better Auth (trustedOrigins) et
# par les liens des emails. Doit correspondre exactement au domaine servi.
PUBLIC_URL=https://reboot.joinhashcode.com

# Réseau Traefik : voir « Noms de réseaux et de volumes » plus bas.
# Entrypoint TLS et résolveur de certificat de ton Traefik.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- PostgreSQL interne ---
# Identifiants du conteneur postgres, base indépendante de tout Neon.
# ⚠️ À ne JAMAIS réutiliser pour une autre base : c'est la cause des
# migrations qui rejouent sur une base déjà peuplée.
POSTGRES_USER=hashcode
POSTGRES_DB=hashcode_reboot
POSTGRES_PASSWORD=

# Nombre de jours conservés par la tâche `pg-backup` du service `cron`
# (pg_dump quotidien + rotation). Appliqué aussi par l'outil hôte
# scripts/backup.sh en cas de sauvegarde manuelle.
BACKUP_RETENTION_DAYS=14

# --- Développement local ---
DEV_URL=http://localhost:3000

# ⚠️ Les NEXT_PUBLIC_* sont FIGÉES dans le bundle au moment du build Docker.
# Changer l'une impose un rebuild : docker compose build --no-cache web

# --- Ressources (limites CPU / RAM par service) ---
# Les plafonds vivent ici, pas dans compose.yml : un VPS plus petit ou plus
# grand se règle en éditant ce fichier, sans toucher au YAML.
#
# Totaux par défaut en production : 3,2 CPU / ~4,1 Go de plafonds.
# Vérifier que le VPS a de la marge au-delà, sinon les conteneurs se font
# tuer en OOM sous charge. Un VPS 2 CPU / 4 Go suffit pour du trafic réel.
#
# ⚠️ WEB_NODE_HEAP doit rester SOUS WEB_MEMORY_LIMIT (640 < 1024).
# Au-delà, Node se fait tuer par l'OOM killer avant d'avoir pu collecter.

# --- PostgreSQL ---
PG_MEMORY_LIMIT=1g              # 1 Go : les agrégats admin sont les requêtes les plus lourdes
PG_MEMORY_RESERVATION=512m
PG_CPU_LIMIT=1.0
PG_SHARED_BUFFERS=512MB         # cache partagé ; ~25 % de la RAM machine est la règle usuelle
PG_EFFECTIVE_CACHE_SIZE=1536MB  # shared_buffers + cache OS, à régler sur la machine
PG_WORK_MEM=8MB                 # par requête et par opération de tri
PG_MAINTENANCE_WORK_MEM=128MB   # VACUUM, index — ne monte pas trop, c'est ponctuel et fort
PG_MAX_CONNECTIONS=50

# --- Application (runtime Node) ---
WEB_MEMORY_LIMIT=1g             # pic réel : rendu serveur des pages admin
WEB_MEMORY_RESERVATION=512m
WEB_CPU_LIMIT=1.0
WEB_NODE_HEAP=640               # en Mo ; doit rester sous WEB_MEMORY_LIMIT

# --- Migrations (build Next.js) ---
# 2 Go : webpack charge tout le graphe de modules en mémoire. Au-delà, le
# build est cassé, pas « lent ».
MIGRATE_MEMORY_LIMIT=2g
MIGRATE_CPU_LIMIT=1.0

# --- Ordonnanceur interne (service cron : crons HTTP + pg-backup) ---
# Quasi inactif hors passages : un plafond bas empêche un run en boucle de
# concurrencer l'application. Remplace l'ancien bloc BACKUP_* (le service
# `backup` n'existe plus, sa charge vit dans `cron`).
CRON_MEMORY_LIMIT=128m
CRON_MEMORY_RESERVATION=32m
CRON_CPU_LIMIT=0.2

# --- Développement (à moitié des réglages prod) ---
PG_DEV_MEMORY_LIMIT=512m
PG_DEV_CPU_LIMIT=0.5
PG_DEV_SHARED_BUFFERS=128MB
PG_DEV_WORK_MEM=4MB
PG_DEV_MAX_CONNECTIONS=20
WEB_DEV_MEMORY_LIMIT=768m
WEB_DEV_CPU_LIMIT=1.5
WEB_DEV_NODE_HEAP=512
MIGRATE_DEV_MEMORY_LIMIT=1g
MIGRATE_DEV_CPU_LIMIT=1.0

# --- Noms de réseaux et de volumes (avancé) ---
# Tout est paramétré ici : ajouter un préfixe propre à une autre personne
# ou à un autre VPS se fait dans ce fichier, sans toucher aux compose.

# Réseau Traefik. Un réseau `proxy` par projet hashcode : la prod s'y attache,
# le dev non. Cloisonner évite que le trafic d'un site parte vers le
# conteneur d'un autre projet.
# ⚠️ Doit correspondre EXACTEMENT au réseau Traefik du VPS, sinon Traefik ne
# voit pas le conteneur et le domaine ne répond pas (page 502).
#   docker network ls | grep proxy
TRAEFIK_NETWORK=proxy

# Réseau privé de la base de données. Nommé pour rester identifiable dans
# `docker network ls` quand plusieurs stacks coexistent sur le même VPS.
BACKEND_NETWORK=proxy-backend
BACKEND_NETWORK_DEV=proxy-backend-dev

# ⚠️ CHANGER UN NOM DE VOLUME = REDÉMARRER SUR UNE BASE VIDE, sans erreur
# visible. Vérifier avant de déployer :
#   docker volume ls | grep hashcode
# Si un volume existe déjà sous un autre nom, le renseigner ici plutôt que
# d'en créer un neuf.
POSTGRES_VOLUME=hashcode_reboot_postgres_data
BACKUP_VOLUME=hashcode_reboot_postgres_backups
POSTGRES_VOLUME_DEV=hashcode_reboot_postgres_data_dev
