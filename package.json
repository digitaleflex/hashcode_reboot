{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node ./scripts/copy-standalone.mjs",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && next build && node ./scripts/copy-standalone.mjs",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test": "npm run test:unit",
    "test:admin-guard": "node --import tsx --test tests/admin-guard.test.cjs",
    "test:unit": "node --import tsx --test tests/unit.test.cjs tests/admin-guard.test.cjs tests/magic-link.test.cjs tests/event-validation.test.cjs tests/events-gate.test.cjs tests/profiling.test.cjs tests/profiling-messages.test.cjs tests/account-rgpd.test.cjs tests/blacklist.test.cjs tests/matching.test.cjs tests/workshop-validation.test.cjs tests/workshop-progression.test.cjs tests/workshop-quiz.test.cjs tests/workshop-emails.test.cjs tests/auth-signup-guard.test.cjs tests/auth-otp-ttl.test.cjs tests/email-categories.test.cjs tests/webhook-memberid.test.cjs tests/phone-fill-ticket.test.cjs tests/admin-sections.test.cjs tests/verify-email-d34.test.cjs tests/legal-content.test.cjs tests/analytics-source.test.cjs tests/legal-content-gaps.test.cjs tests/dead-tables-d36.test.cjs",
    "test:auth": "node --import tsx --test tests/auth-signup-guard.test.cjs",
    "test:email": "node --import tsx --test tests/email-categories.test.cjs",
    "verify:d01": "node scripts/verify-d01.mjs",
    "test:magic-link": "node --import tsx --test tests/magic-link.test.cjs",
    "test:events": "node --import tsx --test tests/event-validation.test.cjs tests/events-gate.test.cjs",
    "test:profiling": "node --import tsx --test tests/profiling.test.cjs tests/profiling-messages.test.cjs",
    "test:integration": "node --import tsx --test tests/integration.test.cjs",
    "test:all": "npm run test:unit && npm run test:integration",
    "collect:metrics": "tsx scripts/collect-email-metrics.ts",
    "seed:email-templates": "node --env-file=.env --import tsx scripts/seed-email-templates.ts",
    "seed:github-program": "node --env-file=.env --import tsx scripts/seed-github-program.ts",
    "seed:workshops": "node --env-file=.env --import tsx scripts/seed-workshops.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run check:test-wiring && npm run test:unit",
    "check:i18n": "node scripts/check-messages.mjs",
    "roadmap": "node scripts/task-tracker.mjs list",
    "roadmap:next": "node scripts/task-tracker.mjs next",
    "roadmap:done": "node scripts/task-tracker.mjs done",
    "roadmap:reset": "node scripts/task-tracker.mjs reset",
    "roadmap:status": "node scripts/task-tracker.mjs status",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "check:test-wiring": "node scripts/check-test-wiring.mjs",
    "test:workshops": "node --import tsx --test tests/workshop-validation.test.cjs tests/workshop-progression.test.cjs tests/workshop-quiz.test.cjs tests/workshop-emails.test.cjs",
    "test:security": "node --import tsx --test tests/blacklist.test.cjs tests/auth-signup-guard.test.cjs tests/auth-otp-ttl.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@sentry/nextjs": "^10.73.0",
    "@tanstack/react-query": "^5.82.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-intl": "^4.3.4",
    "nextjs-toploader": "^3.9.17",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.1",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@parcel/watcher": "^2.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
