# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.development
.env.backup*
.env.*.local
.env.*~

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
# Ancré à la racine : sans `/`, ce motif ignorait TOUT fichier `local-*` du
# dépôt, y compris src/components/reboot/events/local-time-note.tsx, qui n'a
# donc jamais été commité alors que public-events.tsx l'importe.
/local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# local SQLite (legacy dev DB — never commit)
db/*.db
.vercel
*.csv
*.xlsx
*.xls

# outillage local opencode (plugin better-compact + node_modules propres)
/.opencode/

# ── Dette d'audit 2026-10 (voir docs/ROADMAP-SUR-INGENIERIE-2026.md)
# Artefacts de build Playwright : ne doivent jamais être committés (D15)
playwright-report/
test-results/
# Progression du tracker de tâches — propre à la machine
.task-progress.json
# Outillage d'agents local (non versionné)
.kilo/
.mimocode/
# Cache d'analyse i18n : regenere par `node scripts/analyze-i18n.mjs --json`,
# dont depend `scripts/purge-i18n.mjs`. Artefact local, pas une source.
scripts/.i18n-report.json
